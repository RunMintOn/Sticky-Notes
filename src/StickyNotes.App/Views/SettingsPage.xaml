<UserControl x:Class="StickyNotes.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource PrimaryText}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
            <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                    Width="38" Height="38" Margin="-8,0,6,0" Background="Transparent"
                    Foreground="{StaticResource PrimaryText}" BorderThickness="0"
                    Click="Back_Click" ToolTip="{DynamicResource BackText}"/>
            <TextBlock Text="{DynamicResource SettingsText}" FontSize="{DynamicResource TitleFontSize}"
                       FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel MaxWidth="560" HorizontalAlignment="Stretch">
                <TextBlock Text="{DynamicResource AppearanceText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBlock Text="{DynamicResource LanguageText}" FontSize="16" Margin="0,0,0,7"/>
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          AutomationProperties.Name="{DynamicResource LanguageText}"
                          SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                          Height="34" Padding="8,3" Margin="0,0,0,20"/>

                <DockPanel>
                    <TextBlock Text="{DynamicResource LayoutScaleText}" FontSize="16"/>
                    <TextBlock Text="{Binding OverallScale, StringFormat={}{0:F2}×}"
                               Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource LayoutScaleHelp}"
                           Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                <Slider Minimum="0.80" Maximum="1.20" TickFrequency="0.01" IsSnapToTickEnabled="True"
                        Value="{Binding OverallScale, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,20"/>

                <DockPanel>
                    <TextBlock Text="{DynamicResource TextScaleText}" FontSize="16"/>
                    <TextBlock Text="{Binding TextScale, StringFormat={}{0:F2}×}"
                               Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource TextScaleHelp}"
                           Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                <Slider Minimum="0.75" Maximum="1.20" TickFrequency="0.01" IsSnapToTickEnabled="True"
                        Value="{Binding TextScale, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,20"/>

                <DockPanel>
                    <TextBlock Text="{DynamicResource IconScaleText}" FontSize="16"/>
                    <TextBlock Text="{Binding IconScale, StringFormat={}{0:F2}×}"
                               Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource IconScaleHelp}"
                           Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                <Slider Minimum="0.75" Maximum="1.25" TickFrequency="0.01" IsSnapToTickEnabled="True"
                        Value="{Binding IconScale, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,20"/>

                <TextBlock Text="{DynamicResource TextRenderingText}" FontSize="16" Margin="0,0,0,7"/>
                <ComboBox ItemsSource="{Binding AvailableRenderingProfiles}"
                          AutomationProperties.Name="{DynamicResource TextRenderingText}"
                          SelectedItem="{Binding RenderingProfile, UpdateSourceTrigger=PropertyChanged}"
                          Height="34" Padding="8,3" Margin="0,0,0,24"/>

                <TextBlock Text="{DynamicResource EditingText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <CheckBox Content="{DynamicResource HoverMarkersText}"
                          IsChecked="{Binding RevealMarkdownOnHover, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="15" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource HoverMarkersHelp}"
                           Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,0,0,24"/>

                <CheckBox Content="{DynamicResource ContinueListsText}"
                          IsChecked="{Binding AutoContinueLists, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="15" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource ContinueListsHelp}"
                           Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,0,0,24"/>

                <Expander Header="{DynamicResource CodeBlockTuningText}" Foreground="{StaticResource PrimaryText}"
                          FontSize="16" Margin="0,0,0,22">
                    <StackPanel Margin="22,14,4,4">
                        <DockPanel><TextBlock Text="{DynamicResource CodeBlockLeftText}"/><TextBlock Text="{Binding CodeBlockLeftOffset, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="-16" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockLeftOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                        <DockPanel><TextBlock Text="{DynamicResource CodeBlockRightText}"/><TextBlock Text="{Binding CodeBlockRightOffset, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="-16" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockRightOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                        <DockPanel><TextBlock Text="{DynamicResource CodeBlockTopText}"/><TextBlock Text="{Binding CodeBlockTopExtent, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockTopExtent, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                        <DockPanel><TextBlock Text="{DynamicResource CodeBlockBottomText}"/><TextBlock Text="{Binding CodeBlockBottomExtent, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockBottomExtent, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                        <DockPanel><TextBlock Text="{DynamicResource CodeBlockRadiusText}"/><TextBlock Text="{Binding CodeBlockCornerRadius, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockCornerRadius, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                        <DockPanel><TextBlock Text="{DynamicResource CodeBlockShadeText}"/><TextBlock Text="{Binding CodeBlockBackgroundShade, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="20" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockBackgroundShade, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                        <DockPanel><TextBlock Text="{DynamicResource CopySizeText}"/><TextBlock Text="{Binding CodeBlockCopyButtonSize, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="18" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockCopyButtonSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                        <DockPanel><TextBlock Text="{DynamicResource CopyTopText}"/><TextBlock Text="{Binding CodeBlockCopyButtonTopOffset, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockCopyButtonTopOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                        <DockPanel><TextBlock Text="{DynamicResource CopyRightText}"/><TextBlock Text="{Binding CodeBlockCopyButtonRightOffset, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CodeBlockCopyButtonRightOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,4"/>
                    </StackPanel>
                </Expander>

                <Button Content="{DynamicResource ResetSettingsText}" MinWidth="140" Padding="14,0" Height="36"
                        HorizontalAlignment="Left" Click="Reset_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
