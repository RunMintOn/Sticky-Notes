<UserControl x:Class="StickyNotes.App.Views.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource PrimaryText}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
            <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                    Width="38" Height="38" Margin="-8,0,6,0" Background="Transparent"
                    Foreground="{StaticResource PrimaryText}" BorderThickness="0"
                    Click="Back_Click" ToolTip="{DynamicResource BackText}"/>
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource TitleFontSize}"
                       FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel MaxWidth="580" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Introduction}" Foreground="{StaticResource SecondaryText}"
                           FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryText}"
                                                               FontSize="14" TextWrapping="Wrap" Margin="0,2,16,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#3C3C3C" CornerRadius="3" Padding="7,3"
                                                        VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Shortcut}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Shortcut}" FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="13" Foreground="#D0D0D0"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
