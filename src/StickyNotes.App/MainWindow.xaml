<Window x:Class="StickyNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:StickyNotes.App"
        Title="Sticky Notes" Width="540" Height="800" MinWidth="390" MinHeight="480"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource InterfaceFontFamily}"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        TextOptions.TextHintingMode="{DynamicResource TextHintingMode}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource HeaderHeight}" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource HeaderGridLength}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddNoteButton" Content="&#xE710;" Style="{StaticResource ChromeButton}" Foreground="#AAAAAA"
                        Click="AddNote_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource NewNoteText}"/>
                <Button x:Name="BringToFrontButton" Content="&#xE8A7;" Style="{StaticResource ChromeButton}" Foreground="#AAAAAA"
                        Click="BringToFront_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{DynamicResource BringToFrontText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="HelpButton" Content="?" Style="{StaticResource ChromeButton}" Foreground="#AAAAAA"
                        FontFamily="{DynamicResource InterfaceFontFamily}" FontWeight="SemiBold"
                        Click="Help_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource HelpText}"/>
                <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource ChromeButton}" Foreground="#AAAAAA"
                        Click="Settings_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource SettingsText}"/>
                <Button Content="&#xE8BB;" Style="{StaticResource ChromeButton}" Foreground="#AAAAAA"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="NotesPage" Grid.Row="1" Margin="15,0,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource AppNameText}" FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold" Margin="0,5,0,14"/>

            <Grid Grid.Row="1" Height="44" Margin="0,0,0,15">
                <TextBox x:Name="SearchBox" FontSize="{DynamicResource ListFontSize}" Padding="16,8,44,8"
                         Background="#404040" Foreground="{StaticResource PrimaryText}"
                         BorderThickness="0" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="{DynamicResource SearchText}" FontSize="{DynamicResource ListFontSize}" Foreground="#B0B0B0" Margin="16,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource ChromeIconSize}"
                           Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,14,0" IsHitTestVisible="False"/>
            </Grid>

            <ListBox x:Name="NotesList" Grid.Row="2" ItemsSource="{Binding NotesView}"
                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryText}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="NotesList_MouseDoubleClick"
                     PreviewMouseWheel="NotesList_PreviewMouseWheel">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Selection" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Selection" Property="Background" Value="Transparent"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Selection" Property="Background" Value="#18FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="{DynamicResource NoteCardMinHeight}"
                                MaxHeight="{DynamicResource NoteCardHeight}" CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource NoteBackground}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Background" Value="#3B3B3B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource NoteCardContextMenu}">
                                    <MenuItem Header="{DynamicResource OpenNoteText}" Click="OpenNoteMenu_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource NoteCardMenuItem}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource CloseNoteText}" Click="CloseNoteMenu_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource NoteCardMenuItem}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource DeleteNoteText}" Style="{StaticResource NoteCardMenuItem}"
                                              Click="DeleteNoteMenu_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{Binding Color, Converter={StaticResource NoteColorConverter}}"
                                        CornerRadius="2,2,0,0"/>
                                <Grid Grid.Row="1" Margin="18,12,12,12">
                                    <TextBlock Text="{Binding Preview}" FontSize="{DynamicResource ListFontSize}" LineHeight="26"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="145" Margin="0,12,60,0"/>
                                    <TextBlock Text="{Binding UpdatedLabel}" Foreground="{StaticResource SecondaryText}"
                                               FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                                <Grid Grid.RowSpan="2" Width="18" Height="18"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- The original corner is cut away; the flap folds back toward the upper-left. -->
                                    <Path Data="M0,18 L18,0 L18,18 Z" Fill="{StaticResource AppBackground}" Stretch="Fill"/>
                                    <Path Data="M0,18 L0,0 L18,0 Z" Fill="#5B5B5B" Stretch="Fill"/>
                                    <Path Data="M0,18 L18,0" Stroke="#777777" StrokeThickness="1" Stretch="Fill"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid x:Name="SettingsPage" Grid.Row="1" Margin="15,0,15,15" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Width="38" Height="38" Margin="-8,0,6,0" Background="Transparent"
                        Foreground="{StaticResource PrimaryText}" BorderThickness="0"
                        Click="SettingsBack_Click" ToolTip="{DynamicResource BackText}"/>
                <TextBlock Text="{DynamicResource SettingsText}" FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel MaxWidth="560" HorizontalAlignment="Stretch">
                    <TextBlock Text="{DynamicResource AppearanceText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="{DynamicResource LanguageText}" FontSize="16" Margin="0,0,0,7"/>
                    <ComboBox ItemsSource="{Binding Settings.AvailableLanguages}"
                              SelectedItem="{Binding Settings.Language, UpdateSourceTrigger=PropertyChanged}"
                              Height="34" Padding="8,3" Margin="0,0,0,20"/>

                    <DockPanel>
                        <TextBlock Text="{DynamicResource LayoutScaleText}" FontSize="16"/>
                        <TextBlock Text="{Binding Settings.OverallScale, StringFormat={}{0:F2}×}"
                                   Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource LayoutScaleHelp}"
                               Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                    <Slider Minimum="0.80" Maximum="1.20" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.OverallScale, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,8,0,20"/>

                    <DockPanel>
                        <TextBlock Text="{DynamicResource TextScaleText}" FontSize="16"/>
                        <TextBlock Text="{Binding Settings.TextScale, StringFormat={}{0:F2}×}"
                                   Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource TextScaleHelp}"
                               Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                    <Slider Minimum="0.75" Maximum="1.20" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.TextScale, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,8,0,20"/>

                    <DockPanel>
                        <TextBlock Text="{DynamicResource IconScaleText}" FontSize="16"/>
                        <TextBlock Text="{Binding Settings.IconScale, StringFormat={}{0:F2}×}"
                                   Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource IconScaleHelp}"
                               Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                    <Slider Minimum="0.75" Maximum="1.25" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.IconScale, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,8,0,20"/>

                    <TextBlock Text="{DynamicResource TextRenderingText}" FontSize="16" Margin="0,0,0,7"/>
                    <ComboBox ItemsSource="{Binding Settings.AvailableRenderingProfiles}"
                              SelectedItem="{Binding Settings.RenderingProfile, UpdateSourceTrigger=PropertyChanged}"
                              Height="34" Padding="8,3" Margin="0,0,0,24"/>

                    <TextBlock Text="{DynamicResource EditingText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <CheckBox Content="{DynamicResource HoverMarkersText}"
                              IsChecked="{Binding Settings.RevealMarkdownOnHover, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="15" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource HoverMarkersHelp}"
                               Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,0,0,24"/>

                    <CheckBox Content="{DynamicResource ContinueListsText}"
                              IsChecked="{Binding Settings.AutoContinueLists, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="15" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource ContinueListsHelp}"
                               Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,0,0,24"/>

                    <Expander Header="{DynamicResource CodeBlockTuningText}" Foreground="{StaticResource PrimaryText}"
                              FontSize="16" Margin="0,0,0,22">
                        <StackPanel Margin="22,14,4,4">
                            <DockPanel><TextBlock Text="{DynamicResource CodeBlockLeftText}"/><TextBlock Text="{Binding Settings.CodeBlockLeftOffset, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="-16" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockLeftOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                            <DockPanel><TextBlock Text="{DynamicResource CodeBlockRightText}"/><TextBlock Text="{Binding Settings.CodeBlockRightOffset, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="-16" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockRightOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                            <DockPanel><TextBlock Text="{DynamicResource CodeBlockTopText}"/><TextBlock Text="{Binding Settings.CodeBlockTopExtent, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockTopExtent, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                            <DockPanel><TextBlock Text="{DynamicResource CodeBlockBottomText}"/><TextBlock Text="{Binding Settings.CodeBlockBottomExtent, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockBottomExtent, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                            <DockPanel><TextBlock Text="{DynamicResource CodeBlockRadiusText}"/><TextBlock Text="{Binding Settings.CodeBlockCornerRadius, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockCornerRadius, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                            <DockPanel><TextBlock Text="{DynamicResource CodeBlockShadeText}"/><TextBlock Text="{Binding Settings.CodeBlockBackgroundShade, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="20" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockBackgroundShade, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                            <DockPanel><TextBlock Text="{DynamicResource CopySizeText}"/><TextBlock Text="{Binding Settings.CodeBlockCopyButtonSize, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="18" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockCopyButtonSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                            <DockPanel><TextBlock Text="{DynamicResource CopyTopText}"/><TextBlock Text="{Binding Settings.CodeBlockCopyButtonTopOffset, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockCopyButtonTopOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>

                            <DockPanel><TextBlock Text="{DynamicResource CopyRightText}"/><TextBlock Text="{Binding Settings.CodeBlockCopyButtonRightOffset, StringFormat={}{0:F0}}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.CodeBlockCopyButtonRightOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,4"/>

                        </StackPanel>
                    </Expander>

                    <Button Content="{DynamicResource ResetSettingsText}" MinWidth="140" Padding="14,0" Height="36" HorizontalAlignment="Left"
                            Click="SettingsReset_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="HelpPage" Grid.Row="1" Margin="15,0,15,15" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Width="38" Height="38" Margin="-8,0,6,0" Background="Transparent"
                        Foreground="{StaticResource PrimaryText}" BorderThickness="0"
                        Click="HelpBack_Click" ToolTip="{DynamicResource BackText}"/>
                <TextBlock Text="{Binding Help.Title}" FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel MaxWidth="580" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding Help.Introduction}" Foreground="{StaticResource SecondaryText}"
                               FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <ItemsControl ItemsSource="{Binding Help.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,22">
                                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryText}"
                                                                   FontSize="14" TextWrapping="Wrap" Margin="0,2,16,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#3C3C3C" CornerRadius="3" Padding="7,3"
                                                            VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Shortcut}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Shortcut}" FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="13" Foreground="#D0D0D0"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
