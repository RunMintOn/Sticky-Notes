<Window x:Class="StickyNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:StickyNotes.App"
        Title="Sticky Notes" Width="681" Height="800" MinWidth="390" MinHeight="480"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource InterfaceFontFamily}"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        TextOptions.TextHintingMode="{DynamicResource TextHintingMode}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource HeaderHeight}" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource HeaderGridLength}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="AddNoteButton" Content="&#xE710;" Style="{StaticResource ChromeButton}" Foreground="#AAAAAA"
                    HorizontalAlignment="Left" Click="AddNote_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="New note"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource ChromeButton}" Foreground="#AAAAAA"
                        Click="Settings_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Settings"/>
                <Button Content="&#xE8BB;" Style="{StaticResource ChromeButton}" Foreground="#AAAAAA"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="NotesPage" Grid.Row="1" Margin="15,0,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Sticky Notes" FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold" Margin="0,5,0,14"/>

            <Grid Grid.Row="1" Height="44" Margin="0,0,0,15">
                <TextBox x:Name="SearchBox" FontSize="{DynamicResource ListFontSize}" Padding="16,8,44,8"
                         Background="#404040" Foreground="{StaticResource PrimaryText}"
                         BorderThickness="0" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="Search..." FontSize="{DynamicResource ListFontSize}" Foreground="#B0B0B0" Margin="16,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource ChromeIconSize}"
                           Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,14,0" IsHitTestVisible="False"/>
            </Grid>

            <ListBox x:Name="NotesList" Grid.Row="2" ItemsSource="{Binding NotesView}"
                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryText}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="NotesList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Selection" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Selection" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Selection" Property="Background" Value="#18FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="{DynamicResource NoteCardMinHeight}"
                                MaxHeight="{DynamicResource NoteCardHeight}"
                                Background="{StaticResource NoteBackground}" CornerRadius="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{Binding Color, Converter={StaticResource NoteColorConverter}}"
                                        CornerRadius="2,2,0,0"/>
                                <Grid Grid.Row="1" Margin="18,12,12,12">
                                    <TextBlock Text="{Binding Preview}" FontSize="{DynamicResource ListFontSize}" LineHeight="26"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="145" Margin="0,12,60,0"/>
                                    <TextBlock Text="{Binding UpdatedLabel}" Foreground="{StaticResource SecondaryText}"
                                               FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                                <Path Grid.RowSpan="2" Data="M0,16 L16,0 L16,16 Z" Fill="#696969"
                                      Width="16" Height="16" Stretch="Fill"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid x:Name="SettingsPage" Grid.Row="1" Margin="15,0,15,15" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Width="38" Height="38" Margin="-8,0,6,0" Background="Transparent"
                        Foreground="{StaticResource PrimaryText}" BorderThickness="0"
                        Click="SettingsBack_Click" ToolTip="Back"/>
                <TextBlock Text="Settings" FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="560" HorizontalAlignment="Stretch">
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <DockPanel>
                        <TextBlock Text="Layout scale" FontSize="16"/>
                        <TextBlock Text="{Binding Settings.OverallScale, StringFormat={}{0:F2}×}"
                                   Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="Control heights, spacing, cards, and menus"
                               Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                    <Slider Minimum="0.80" Maximum="1.20" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.OverallScale, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,8,0,20"/>

                    <DockPanel>
                        <TextBlock Text="Text scale" FontSize="16"/>
                        <TextBlock Text="{Binding Settings.TextScale, StringFormat={}{0:F2}×}"
                                   Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="Note content, lists, search, and menu labels"
                               Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                    <Slider Minimum="0.75" Maximum="1.20" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.TextScale, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,8,0,20"/>

                    <DockPanel>
                        <TextBlock Text="Icon scale" FontSize="16"/>
                        <TextBlock Text="{Binding Settings.IconScale, StringFormat={}{0:F2}×}"
                                   Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="Title-bar commands and formatting tools"
                               Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                    <Slider Minimum="0.75" Maximum="1.25" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.IconScale, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,8,0,20"/>

                    <TextBlock Text="Text rendering" FontSize="16" Margin="0,0,0,7"/>
                    <ComboBox ItemsSource="{Binding Settings.AvailableRenderingProfiles}"
                              SelectedItem="{Binding Settings.RenderingProfile, UpdateSourceTrigger=PropertyChanged}"
                              Height="34" Padding="8,3" Margin="0,0,0,24"/>

                    <TextBlock Text="Editing" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <CheckBox Content="Reveal Markdown markers when the pointer hovers over a line"
                              IsChecked="{Binding Settings.RevealMarkdownOnHover, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="15" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,8"/>
                    <TextBlock Text="When disabled, markers appear only on the line containing the caret."
                               Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,0,0,24"/>

                    <Button Content="Reset all settings" Width="140" Height="36" HorizontalAlignment="Left"
                            Click="SettingsReset_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
