<Window x:Class="StickyNotes.App.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:markdown="clr-namespace:StickyNotes.App.Markdown"
        Title="Note" Width="570" Height="424" MinWidth="280" MinHeight="220"
        Background="{StaticResource NoteBackground}" Foreground="{StaticResource PrimaryText}"
        WindowStyle="None" ResizeMode="CanResize" Activated="Window_Activated"
        Deactivated="Window_Deactivated" LocationChanged="WindowBounds_Changed"
        SizeChanged="WindowBounds_Changed" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource InterfaceFontFamily}"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        TextOptions.TextHintingMode="{DynamicResource TextHintingMode}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource HeaderHeight}" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource HeaderGridLength}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{DynamicResource ToolbarGridLength}"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Height="{DynamicResource HeaderHeight}" VerticalAlignment="Top"
              Background="{Binding Color, Converter={StaticResource NoteColorConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="&#xE710;" Style="{StaticResource ChromeButton}" Foreground="#66000000"
                    HorizontalAlignment="Left" Click="NewNote_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="New note"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MoreButton" Content="&#xE712;" Style="{StaticResource ChromeButton}"
                        Foreground="#66000000" Click="More_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Menu"/>
                <Button Content="&#xE8BB;" Style="{StaticResource ChromeButton}" Foreground="#66000000"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <markdown:MarkdownEditor x:Name="Editor" Grid.Row="1" TextChanged="Editor_TextChanged"
                                 PasteImageRequested="Editor_PasteImageRequested"/>

        <Border x:Name="Toolbar" Grid.Row="2" Height="{DynamicResource ToolbarHeight}"
                VerticalAlignment="Bottom" BorderBrush="#454545" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="B" Style="{StaticResource FormatButton}" FontWeight="Bold" Click="Bold_Click"/>
                <Button Content="I" Style="{StaticResource FormatButton}" FontStyle="Italic" Click="Italic_Click"/>
                <Button Content="&lt;/&gt;" Style="{StaticResource FormatButton}" Click="InlineCode_Click"
                        ToolTip="Inline code"/>
                <Button Style="{StaticResource FormatButton}" Click="Strike_Click">
                    <TextBlock Text="ab" TextDecorations="Strikethrough"/>
                </Button>
                <Button Content="☷" Style="{StaticResource FormatButton}" Click="Bullets_Click"/>
                <Button Content="▧" Style="{StaticResource FormatButton}" Click="Image_Click" ToolTip="Insert image"/>
            </StackPanel>
        </Border>

        <primitives:Popup x:Name="NoteMenuPopup" PlacementTarget="{Binding ElementName=MoreButton}"
                          Placement="Relative" VerticalOffset="0" AllowsTransparency="True"
                          StaysOpen="False" PopupAnimation="Fade">
            <Border Width="{DynamicResource NoteMenuWidth}" Background="#3B3B3B" Effect="{x:Null}">
                <StackPanel>
                    <UniformGrid Rows="1" Columns="7" Height="{DynamicResource NoteMenuPaletteHeight}">
                        <Button Background="#E6B904" BorderThickness="0" Tag="Yellow" Click="Color_Click"/>
                        <Button Background="#65BA5A" BorderThickness="0" Tag="Green" Click="Color_Click"/>
                        <Button Background="#EA86C2" BorderThickness="0" Tag="Pink" Click="Color_Click"/>
                        <Button Background="#B07FE0" BorderThickness="0" Tag="Purple" Click="Color_Click"/>
                        <Button Background="#59C0E7" BorderThickness="0" Tag="Blue" Click="Color_Click"/>
                        <Button Background="#989898" BorderThickness="0" Tag="Gray" Click="Color_Click"/>
                        <Button Background="#484848" BorderThickness="0" Tag="Charcoal" Click="Color_Click"/>
                    </UniformGrid>
                    <Border Height="1" Background="#505050"/>
                    <Button Style="{StaticResource NoteMenuButton}" Click="NotesList_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource ChromeIconSize}" Width="40"/>
                            <TextBlock Text="Notes list"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NoteMenuButton}" Click="Delete_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource ChromeIconSize}" Width="40"/>
                            <TextBlock Text="Delete note"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </primitives:Popup>
    </Grid>
</Window>
