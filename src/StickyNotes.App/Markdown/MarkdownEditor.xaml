<UserControl x:Class="StickyNotes.App.Markdown.MarkdownEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
             TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
             TextOptions.TextHintingMode="{DynamicResource TextHintingMode}">
    <UserControl.Resources>
        <Style x:Key="ThinScrollThumb" TargetType="Thumb">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody" Width="4" Margin="1,0" CornerRadius="2"
                                Background="#686868"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#888888"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#A0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodeCopyButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#AFAFAF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#20FFFFFF"/>
                                <Setter Property="Foreground" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="EditorRoot" Background="{StaticResource NoteBackground}">
        <Canvas x:Name="CodeBlockBackground" Background="{x:Null}" IsHitTestVisible="False"/>
        <avalonEdit:TextEditor x:Name="TextEditor"
                           Background="Transparent"
                           Foreground="{StaticResource PrimaryText}"
                           FontFamily="{DynamicResource EditorFontFamily}"
                           FontSize="{DynamicResource EditorFontSize}"
                           Padding="0"
                           BorderThickness="0"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"
                           TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
                           TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
                           TextOptions.TextHintingMode="{DynamicResource TextHintingMode}"
                           ShowLineNumbers="False"
                           WordWrap="True"
                           HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Auto"/>
        <Canvas x:Name="ImageOverlay" Background="{x:Null}" ClipToBounds="True"/>
        <Canvas x:Name="CodeBlockOverlay" Background="{x:Null}"/>

        <Border x:Name="ImagePreviewScrim" Background="#66000000" Visibility="Collapsed"
                MouseLeftButtonDown="ImagePreviewScrim_MouseLeftButtonDown"/>

        <Popup x:Name="ImagePreviewPopup" PlacementTarget="{Binding ElementName=EditorRoot}"
               Placement="Center" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Closed="ImagePreviewPopup_Closed">
            <Grid x:Name="ImagePreviewCard" Width="720" Height="520">
                <Border Background="#3D3D3D" BorderBrush="#5B5B5B"
                        BorderThickness="1" CornerRadius="9">
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="43"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="13,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ImagePreviewName" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ImagePreviewDetails" FontSize="11"
                                           Foreground="{StaticResource SecondaryText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="OpenImageOriginalButton" Content="↗" Width="29" Height="29" Margin="0,0,2,0"
                                        Background="Transparent" Foreground="{StaticResource PrimaryText}"
                                        BorderThickness="0" FontSize="17" Cursor="Hand"
                                        ToolTip="Open original" Click="OpenImageOriginal_Click"/>
                                <Button Content="×" Width="29" Height="29" Background="Transparent"
                                        Foreground="{StaticResource PrimaryText}" BorderThickness="0"
                                        FontSize="18" Cursor="Hand" ToolTip="Close"
                                        Click="CloseImagePreview_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Background="#292929">
                            <Image x:Name="ImagePreviewSource" Stretch="Uniform"/>
                            <TextBlock x:Name="ImagePreviewUnavailable" Text="Image unavailable"
                                       Foreground="{StaticResource SecondaryText}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
                <Thumb x:Name="ImagePreviewResizeGrip" Width="24" Height="24" Margin="0,0,2,2"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" ToolTip="Resize preview"
                       DragDelta="ImagePreviewResize_DragDelta"
                       DragCompleted="ImagePreviewResize_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M5,19 L19,5 M10,19 L19,10 M15,19 L19,15"
                                      Stroke="#B0B0B0" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
